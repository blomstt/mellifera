<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks for the Hive window (src/Gui), run headless under gtk4-broadwayd: a plain
       console app, no test framework. It compiles all of src/ except
       Program.cs (the CLI's entry point).
       Run: dotnet run, with project tests/WindowTests (exits 1 if any check fails). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Hive</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/**/*.cs" Exclude="../../src/Program.cs" LinkBase="src" />
  </ItemGroup>

</Project>
